---
const fields = [
  {
    id: "name",
    name: "name",
    label: "Full name",
    type: "text",
    placeholder: "Jane Doe",
    autocomplete: "name",
  },
  {
    id: "email",
    name: "email",
    label: "Email address",
    type: "email",
    placeholder: "you@example.com",
    autocomplete: "email",
  },
  {
    id: "subject",
    name: "subject",
    label: "Subject",
    type: "text",
    placeholder: "Project inquiry",
  },
];
---

<form
  action="https://formspree.io/f/mkgvvqvp"
  method="POST"
  class="space-y-5"
>
  <!-- Formspree honeypot: bots fill this, humans never see it (display:none keeps it out of the a11y tree) -->
  <div style="display:none">
    <label>Leave this field empty <input type="text" name="_gotcha" autocomplete="off" /></label>
  </div>

  {fields.map((field) => (
    <div>
      <label for={field.id} class="block text-sm font-medium text-ink">
        {field.label}
      </label>
      <input
        type={field.type as "text" | "email"}
        id={field.id}
        name={field.name}
        required
        autocomplete={field.autocomplete}
        enterkeyhint="next"
        placeholder={field.placeholder}
        class="mt-1.5 w-full rounded-md border border-line-strong bg-paper px-3.5 py-2.5 text-[0.9375rem] text-ink transition-colors focus:border-accent"
      />
    </div>
  ))}

  <div>
    <label for="message" class="block text-sm font-medium text-ink">
      Message
    </label>
    <textarea
      id="message"
      name="message"
      rows={6}
      required
      placeholder="What are you building, and where does it stand today?"
      class="mt-1.5 w-full rounded-md border border-line-strong bg-paper px-3.5 py-2.5 text-[0.9375rem] text-ink transition-colors focus:border-accent"
    ></textarea>
  </div>

  <button type="submit" class="btn btn-primary">Send message</button>
</form>
