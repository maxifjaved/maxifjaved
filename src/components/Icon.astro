// Brand glyphs are filled shapes; UI glyphs are strokes.
const filled = ["github", "linkedin", "whatsapp", "email"].includes(name);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? "currentColor" : "none"}
  stroke={filled ? "none" : "currentColor"}
  stroke-width={filled ? undefined : 1.5}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  <path d={paths[name]}></path>
</svg>
