---
import MarkdownIt from "markdown-it";

interface Props {
  summary: string;
}

const { summary } = Astro.props;

if (!summary) {
  return null;
}

const md = new MarkdownIt();
const htmlContent = md.render(summary);
---

<aside class="max-w-3xl rounded-lg border border-line bg-paper-2 p-6">
  <h2 class="eyebrow">In brief</h2>
  <div class="summary-content mt-3 text-[0.9375rem] leading-relaxed text-ink" set:html={htmlContent} />
</aside>

<style>
  .summary-content :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .summary-content :global(li) {
    margin-bottom: 0.375rem;
  }
  .summary-content :global(p) {
    margin-bottom: 0.75rem;
  }
  .summary-content :global(strong) {
    font-weight: 600;
  }
</style>
