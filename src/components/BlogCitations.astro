---
interface Citation {
  id: number;
  title: string;
  url: string;
  accessed: string;
  type: string;
}

interface Props {
  citations: Citation[];
}

const { citations } = Astro.props;

if (!citations || citations.length === 0) {
  return null;
}

// Extract actual URLs if they're wrapped in markdown format [url](url)
const cleanedCitations = citations.map(citation => {
  let url = citation.url;
  const markdownLinkMatch = url.match(/\[([^\]]+)\]\(([^)]+)\)/);
  if (markdownLinkMatch) {
    url = markdownLinkMatch[2];
  }
  return { ...citation, url };
});
---

<section class="max-w-3xl">
  <h2 class="eyebrow">References</h2>
  <ol class="mt-4 space-y-3">
    {cleanedCitations.map((citation) => (
      <li class="flex gap-3 text-sm" id={`citation-${citation.id}`}>
        <span class="figure-value shrink-0 text-sm">[{citation.id}]</span>
        <span class="min-w-0">
          <a
            href={citation.url}
            target="_blank"
            rel="noopener noreferrer"
            class="link"
          >
            {citation.title}
          </a>
          <span class="mt-0.5 block text-xs text-ink-3">
            {citation.type} · accessed {citation.accessed}
          </span>
        </span>
      </li>
    ))}
  </ol>
</section>
