---
import Icon from "./Icon.astro";

export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQItem[];
  title?: string;
  id?: string;
}

const { faqs, title = "Common questions", id = "faq" } = Astro.props;

// FAQ Schema for SEO
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

<section id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="display text-2xl sm:text-3xl text-ink">{title}</h2>
  <div class="mt-5 max-w-3xl border-b border-line">
    {faqs.map((faq) => (
      <details class="group border-t border-line">
        <summary class="flex cursor-pointer items-baseline justify-between gap-4 py-4 font-medium text-ink transition-colors hover:text-accent [&::-webkit-details-marker]:hidden">
          {faq.question}
          <Icon
            name="chevron-down"
            size={16}
            class="shrink-0 translate-y-0.5 text-ink-3 transition-transform group-open:rotate-180"
          />
        </summary>
        <p class="pb-5 pr-8 text-[0.9375rem] leading-relaxed text-ink-2" set:html={faq.answer} />
      </details>
    ))}
  </div>
</section>
