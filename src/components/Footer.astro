---
import Icon from "./Icon.astro";
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-paper-2">
  <div class="shell py-14">
    <div class="grid gap-10 sm:grid-cols-[1.6fr_1fr_1fr]">
      <div>
        <p class="display text-xl text-ink">Muhammad Asif Javed</p>
        <p class="mt-3 max-w-sm text-[0.9375rem] leading-relaxed text-ink-2">
          AI platform engineer &amp; full-stack developer. Ten years of
          building production systems end to end, solo.
        </p>
        <div class="mt-5 flex flex-col gap-1.5 text-[0.9375rem]">
          <a href="mailto:axif.javed@gmail.com" class="link">axif.javed@gmail.com</a>
          <a href="https://wa.me/923324647331" rel="noopener" class="link">WhatsApp +92 332 464 7331</a>
        </div>
      </div>

      <nav aria-label="Site index">
        <h2 class="eyebrow">Index</h2>
        <ul class="mt-4 space-y-2 text-[0.9375rem]">
          <li><a href="/projects" class="text-ink-2 hover:text-ink transition-colors">Work</a></li>
          <li><a href="/blogs" class="text-ink-2 hover:text-ink transition-colors">Writing</a></li>
          <li><a href="/about" class="text-ink-2 hover:text-ink transition-colors">About</a></li>
          <li><a href="/contact" class="text-ink-2 hover:text-ink transition-colors">Contact</a></li>
          <li><a href="/uses" class="text-ink-2 hover:text-ink transition-colors">Uses</a></li>
          <li>
            <a href="/maxifjaved.pdf" class="text-ink-2 hover:text-ink transition-colors inline-flex items-center gap-1.5">
              Résumé <span class="figure-label normal-case">(PDF)</span>
            </a>
          </li>
        </ul>
      </nav>

      <nav aria-label="Elsewhere">
        <h2 class="eyebrow">Elsewhere</h2>
        <ul class="mt-4 space-y-2 text-[0.9375rem]">
          <li>
            <a href="https://github.com/maxifjaved" rel="noopener" class="inline-flex items-center gap-2 text-ink-2 hover:text-ink transition-colors">
              <Icon name="github" size={16} /> GitHub
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/maxifjaved" rel="noopener" class="inline-flex items-center gap-2 text-ink-2 hover:text-ink transition-colors">
              <Icon name="linkedin" size={16} /> LinkedIn
            </a>
          </li>
          <li>
            <a href="/rss.xml" class="inline-flex items-center gap-2 text-ink-2 hover:text-ink transition-colors">
              <Icon name="rss" size={16} /> RSS
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="mt-12 flex flex-wrap items-baseline justify-between gap-4 border-t border-line pt-6">
      <p class="text-sm text-ink-3">
        © {year} Muhammad Asif Javed
      </p>
      <p class="text-sm text-ink-3">
        Set in Newsreader &amp; Inter · Built with Astro
      </p>
      <ul class="flex gap-4 text-sm">
        <li><a href="/privacy" class="text-ink-3 hover:text-ink-2 transition-colors">Privacy</a></li>
        <li><a href="/terms" class="text-ink-3 hover:text-ink-2 transition-colors">Terms</a></li>
        <li><a href="/cookie-policy" class="text-ink-3 hover:text-ink-2 transition-colors">Cookies</a></li>
      </ul>
    </div>
  </div>
</footer>
