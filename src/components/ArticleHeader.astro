---
interface Author {
  name: string;
  bio: string;
  avatar: string;
}

interface FeaturedImageData {
  src: string;
  alt: string;
  caption?: string | null;
  width?: number;
  height?: number;
}

interface Props {
  title: string;
  subtitle: string;
  category: string;
  date: Date;
  author: Author;
  readTime: string;
  featuredImageData: FeaturedImageData;
}

const { title, subtitle, category, date, author, readTime, featuredImageData } =
  Astro.props;

const published = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<header class="shell pt-10 sm:pt-14">
  <div class="max-w-3xl">
    <p class="eyebrow">
      {category} · {published} · {readTime}
    </p>
    <h1 class="display mt-4 text-4xl sm:text-5xl text-ink">{title}</h1>
    {subtitle && (
      <p class="display mt-4 text-xl sm:text-2xl text-ink-2"><em>{subtitle}</em></p>
    )}
    <p class="mt-5 text-[0.9375rem] text-ink-2">
      By <span class="font-medium text-ink">{author.name}</span>
    </p>
  </div>

  <figure class="mt-10">
    <img
      src={featuredImageData.src}
      alt={featuredImageData.alt}
      width={featuredImageData.width || 1200}
      height={featuredImageData.height || 630}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="w-full rounded-lg border border-line"
    />
    {featuredImageData.caption && (
      <figcaption class="mt-3 text-sm italic text-ink-3">
        {featuredImageData.caption}
      </figcaption>
    )}
  </figure>
</header>
