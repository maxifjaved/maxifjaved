---
import { Image } from 'astro:assets';

export interface HeroType {
  title: string;
  subtitle: string;
  description: string;
  img: string;
  skillsLabels: string[];
  experienceLabels: string[];
  buttons: {
    label: string;
    href: string;
    isPrimary: boolean;
    isSmooth: boolean;
  }[];
  socialLinks: { icon: string; href: string }[];
}

const heroData: HeroType = {
  title: "Muhammad Asif Javed",
  subtitle: "Full-Stack Developer & Real-time Systems Expert",
  description:
    "Building enterprise-grade platforms from educational collaboration systems to cybersecurity intelligence tools | 10+ years experience | Specialized in WebRTC, real-time technologies, and scalable architectures",
  img: "/img/future-ai.png",
  skillsLabels: ["WebRTC Expert", "React & Node.js", "TypeScript Pro", "System Architect"],
  experienceLabels: ["10+ Years Experience", "Digital Signage Expert", "Enterprise Solutions", "RAG & AI Systems"],
  buttons: [
    {
      label: "View Projects",
      href: "#projects",
      isPrimary: true,
      isSmooth: true,
    },
    {
      label: "Contact Me",
      href: "/contact",
      isPrimary: false,
      isSmooth: false,
    },
  ],
  socialLinks: [
    { icon: "fab fa-github", href: "https://github.com/maxifjaved" },
    { icon: "fab fa-linkedin", href: "https://www.linkedin.com/in/maxifjaved" },
    {
      icon: "fab fa-whatsapp",
      href: "https://wa.me/923324647331",
    },
  ],
};
---

<section
  id="home"
  class="min-h-screen flex items-center pt-20 relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-6 py-24 relative">
    <div
      class="absolute w-96 h-96 bg-cyber-blue/10 rounded-full blur-3xl -top-20 -left-20 animate-pulse-slow"
    >
    </div>
    <div
      class="absolute w-64 h-64 bg-cyber-blue/10 rounded-full blur-3xl bottom-10 right-10 animate-pulse-slow"
      style="animation-delay: 2s;"
    >
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative">
      <div class="order-2 lg:order-1">
        <h1 class="text-4xl lg:text-6xl font-bold mb-4">
          <span class="text-cyber-blue text-shadow-glow">{heroData.title}</span>
          <br />
          {heroData.subtitle}
        </h1>
        <p class="text-gray-300 text-lg mb-8">{heroData.description}</p>

        <div class="flex flex-wrap gap-4 font-future">
          {
            heroData.buttons.map((button) => (
              <a
                href={button.href}
                data-type={button.isSmooth ? "smooth" : "link"}
                class={`max-sm:w-full inline-flex items-start justify-center gap-2 cyber-btn ${
                  button.isPrimary
                    ? "bg-cyber-blue hover:bg-cyber-blue/80 text-cyber-dark"
                    : "bg-transparent border border-cyber-blue text-cyber-blue hover:bg-cyber-blue/10"
                } font-bold py-3 px-8 transition-all duration-300 glow`}
              >
                {button.label}
              </a>
            ))
          }
        </div>

        <div class="mt-12 flex gap-6">
          {
            heroData.socialLinks.map((link) => {
              const platform = link.icon.includes('github') ? 'GitHub' :
                              link.icon.includes('linkedin') ? 'LinkedIn' :
                              link.icon.includes('whatsapp') ? 'WhatsApp' : 'Social media';
              return (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Visit my ${platform} profile`}
                  class="text-cyber-blue hover:text-white transition-colors"
                >
                  <i class={link.icon + " text-2xl"} aria-hidden="true" />
                </a>
              );
            })
          }
        </div>
      </div>

      <div class="order-1 lg:order-2 flex justify-center relative">
        <div class="w-64 h-64 md:w-96 md:h-96 relative">
          <div
            class="absolute inset-0 rounded-full border-4 border-cyber-blue/20 animate-pulse"
          >
          </div>
          <div
            class="absolute inset-0 rounded-full border border-cyber-blue/40 animate-spin"
            style="animation-duration: 20s;"
          >
          </div>

          <div
            class="absolute inset-4 rounded-full bg-cyber-blue/5 backdrop-blur-sm border border-cyber-blue glow"
          >
            <div
              class="relative w-full h-full rounded-full overflow-hidden border border-cyber-blue glow"
            >
              <div class="absolute inset-0 bg-cyber-dark blur-3xl"></div>
              <div class="relative">
                <Image
                  src={heroData.img}
                  alt="Muhammad Asif Javed - WebRTC Expert & Full-Stack Developer"
                  width="384"
                  height="384"
                  width={384}
                  height={384}
                  format="webp"
                  quality={85}
                  loading="eager"
                  fetchpriority="high"
                  class="w-full h-full object-cover"
                />
              </div>
            </div>
          </div>

          <div
            id="skills-badge"
            class="absolute -right-10 md:-right-20 top-0 md:top-1/4 bg-cyber-dark/80 backdrop-blur-sm border border-cyber-blue/20 p-3 rounded-lg shadow-lg glow opacity-0"
          >
            <div class="text-cyber-blue text-sm font-bold font-future min-w-[130px]">
              <span id="skills-label">{heroData.skillsLabels[0]}</span>
            </div>
            <div class="w-32 h-2 bg-gray-700 rounded-full mt-1">
              <div id="progress1" class="h-2 bg-cyber-blue rounded-full"></div>
            </div>
          </div>
          <div
            id="experience-badge"
            class="absolute -left-10 md:-left-20 bottom-0 md:bottom-1/3 bg-cyber-dark/80 backdrop-blur-sm border border-cyber-blue/20 p-3 rounded-lg shadow-lg glow opacity-0"
          >
            <div class="text-cyber-blue text-sm font-bold font-future min-w-[150px]">
              <span id="experience-label">{heroData.experienceLabels[0]}</span>
            </div>
            <div class="w-32 h-2 bg-gray-700 rounded-full mt-1">
              <div id="progress2" class="h-2 bg-cyber-blue rounded-full"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Progress Bar Animation - only animates when visible for better INP
  function animateProgressBars() {
    const progress1 = document.getElementById("progress1");
    const progress2 = document.getElementById("progress2");
    if (!progress1 || !progress2) return;

    let animationId: number;
    const speed1 = 0.15;
    const speed2 = 0.16;
    const range = 20;
    const phaseOffset = Math.PI / 2;

    function updateProgress() {
      progress1.style.width = `${50 + Math.sin((Date.now() * speed1) / 200) * range}%`;
      progress2.style.width = `${70 + Math.sin((Date.now() * speed2) / 150 + phaseOffset) * range}%`;
      animationId = requestAnimationFrame(updateProgress);
    }

    // Only animate when visible using IntersectionObserver
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animationId = requestAnimationFrame(updateProgress);
        } else {
          cancelAnimationFrame(animationId);
        }
      });
    });

    const heroSection = progress1.closest('section') || document.getElementById('home');
    if (heroSection) {
      observer.observe(heroSection);
    }
  }

  window.addEventListener("load", animateProgressBars);

  // Rotating Labels - vanilla JS implementation
  function initRotatingBadges() {
    const skillsLabels = ["WebRTC Expert", "React & Node.js", "TypeScript Pro", "System Architect"];
    const experienceLabels = ["10+ Years Experience", "Digital Signage Expert", "Enterprise Solutions", "RAG & AI Systems"];

    // Setup skills badge (right side)
    const skillsLabel = document.getElementById("skills-label");
    const skillsBadge = document.getElementById("skills-badge");

    // Setup experience badge (left side)
    const experienceLabel = document.getElementById("experience-label");
    const experienceBadge = document.getElementById("experience-badge");

    if (!skillsLabel || !skillsBadge || !experienceLabel || !experienceBadge) return;

    let skillsIndex = 0;
    let experienceIndex = 0;

    // Fade in badges when visible
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          skillsBadge.classList.remove("opacity-0");
          skillsBadge.classList.add("animated", "fadeInLeft", "delay100");
          experienceBadge.classList.remove("opacity-0");
          experienceBadge.classList.add("animated", "fadeInRight", "delay100");
          observer.disconnect();
        }
      });
    });
    observer.observe(skillsBadge);

    // Rotate skills labels every 2.5 seconds
    setInterval(() => {
      skillsIndex = (skillsIndex + 1) % skillsLabels.length;
      skillsLabel.textContent = skillsLabels[skillsIndex];
    }, 2500);

    // Rotate experience labels every 3 seconds (offset timing for visual interest)
    setInterval(() => {
      experienceIndex = (experienceIndex + 1) % experienceLabels.length;
      experienceLabel.textContent = experienceLabels[experienceIndex];
    }, 3000);
  }

  window.addEventListener("load", initRotatingBadges);
</script>
