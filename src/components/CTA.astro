---
export interface CTAType {
  title: string;
  description: string;
  button: { label: string; href: string };
}

const ctaData: CTAType = {
  title: "Let's Build Something Extraordinary Together",
  description:
    "From real-time collaboration platforms to enterprise cybersecurity solutions, I bring 10+ years of expertise in full-stack development, WebRTC, and interactive technologies. Whether you need a complex platform built from scratch or expert consulting on your next project, I deliver production-ready solutions that scale.",
  button: { label: "Schedule a Free Technical Consultation", href: "/contact" },
};
---

<section id="cta" data-scene="network" class="py-24 relative overflow-hidden">
  <div class="max-w-5xl mx-auto px-6">
    <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-cyber-surface/60 px-8 py-16 md:px-16 text-center">
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
        style="background: radial-gradient(ellipse 60% 60% at 50% 0%, rgba(0,229,255,0.12) 0%, transparent 70%);">
      </div>
      <div class="relative">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold mb-6">{ctaData.title}</h2>
        <p class="text-gray-300 text-lg mb-10 max-w-3xl mx-auto">{ctaData.description}</p>
        <div
          x-data="{ visible: false }"
          x-intersect.once="visible = true"
          x-bind:class="visible ? 'animated fadeInUp delay100' : 'opacity-0'"
        >
          <a
            href={ctaData.button.href}
            class="inline-flex items-center justify-center cyber-btn btn-primary py-4 px-10 text-lg"
          >
            {ctaData.button.label}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
