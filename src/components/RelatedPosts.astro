---
// Only slug + title are guaranteed by the content schema.
interface RelatedPost {
  slug: string;
  title: string;
}

interface Props {
  relatedPosts: RelatedPost[];
}

const { relatedPosts } = Astro.props;

if (!relatedPosts || relatedPosts.length === 0) {
  return null;
}
---

<section class="max-w-3xl">
  <div class="flex items-baseline justify-between gap-4">
    <h2 class="eyebrow">Related writing</h2>
    <a href="/blogs" class="link text-sm">All writing</a>
  </div>
  <div class="mt-2">
    {relatedPosts.map((post) => (
      <a
        href={`/blogs/${post.slug}`}
        class="group block border-t border-line py-3.5 first:border-t-0"
      >
        <span class="display text-lg text-ink transition-colors group-hover:text-accent">
          {post.title}
        </span>
      </a>
    ))}
  </div>
</section>
