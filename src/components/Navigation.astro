---
const pagePath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const items = [
  { href: "/projects", label: "Work" },
  { href: "/blogs", label: "Writing" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const isActive = (href: string) =>
  href === "/" ? pagePath === "/" : pagePath.startsWith(href);
---

<header class="border-b border-line bg-paper/90 backdrop-blur-sm sticky top-0 z-40">
  <div class="shell flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4 sm:py-5">
    <a
      href="/"
      class="display text-xl leading-none text-ink hover:text-accent transition-colors"
      aria-label="Muhammad Asif Javed — home"
    >
      Asif&nbsp;Javed
    </a>
    <nav aria-label="Main">
      <ul class="flex items-baseline gap-5 sm:gap-7">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "text-[0.9375rem] font-medium transition-colors underline-offset-[6px]",
                  isActive(item.href)
                    ? "text-ink underline decoration-accent decoration-2"
                    : "text-ink-2 hover:text-ink",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
