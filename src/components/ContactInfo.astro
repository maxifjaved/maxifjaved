---
import Icon from "./Icon.astro";

const channels = [
  {
    icon: "email" as const,
    title: "Email",
    value: "axif.javed@gmail.com",
    href: "mailto:axif.javed@gmail.com",
    note: "Replies within 24 hours",
  },
  {
    icon: "whatsapp" as const,
    title: "WhatsApp",
    value: "+92 332 464 7331",
    href: "https://wa.me/923324647331",
    note: "Quickest for short questions",
  },
  {
    icon: "linkedin" as const,
    title: "LinkedIn",
    value: "linkedin.com/in/maxifjaved",
    href: "https://www.linkedin.com/in/maxifjaved",
    note: "Professional profile",
  },
  {
    icon: "github" as const,
    title: "GitHub",
    value: "github.com/maxifjaved",
    href: "https://github.com/maxifjaved",
    note: "Code and repositories",
  },
];
---

<div>
  <div class="space-y-1">
    {channels.map((channel) => (
      <a
        href={channel.href}
        rel={channel.href.startsWith("http") ? "noopener" : undefined}
        class="group flex items-baseline gap-4 border-t border-line py-4"
      >
        <Icon name={channel.icon} size={16} class="shrink-0 translate-y-0.5 text-ink-3" />
        <span class="min-w-0">
          <span class="block font-medium text-ink transition-colors group-hover:text-accent">
            {channel.value}
          </span>
          <span class="mt-0.5 block text-sm text-ink-2">{channel.note}</span>
        </span>
      </a>
    ))}
  </div>
  <dl class="mt-6 space-y-3 border-t border-line pt-5">
    <div>
      <dt class="figure-label">Location</dt>
      <dd class="mt-0.5 text-sm text-ink">Lahore, Pakistan — working with US, UK &amp; global clients</dd>
    </div>
    <div>
      <dt class="figure-label">Rate</dt>
      <dd class="mt-0.5 text-sm text-ink">$45/hour, or project-based quotes</dd>
    </div>
    <div>
      <dt class="figure-label">Availability</dt>
      <dd class="mt-0.5 text-sm text-ink">Open to new projects · flexible with time zones</dd>
    </div>
  </dl>
</div>
