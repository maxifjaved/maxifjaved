---
export interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const siteUrl = Astro.site || new URL(Astro.url).origin;

// Generate breadcrumb schema (item.url may be relative or absolute)
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": item.url ? new URL(item.url, siteUrl).href : undefined
  })).filter(item => item.item)
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>

<nav aria-label="Breadcrumb" class="shell pt-8">
  <ol class="flex flex-wrap items-baseline gap-x-2 gap-y-1 font-mono text-xs tracking-wide text-ink-3">
    {items.map((item, index) => (
      <li class="flex items-baseline gap-2">
        {index > 0 && <span aria-hidden="true">/</span>}
        {index < items.length - 1 ? (
          <a href={item.url} class="hover:text-ink-2 transition-colors uppercase">
            {item.name}
          </a>
        ) : (
          <span aria-current="page" class="text-ink-2 uppercase">{item.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
