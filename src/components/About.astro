---
import Timeline from "./Timeline.astro";
import Counter from "./Counter.astro";

export interface AboutType {
  title: string;
  mission: {
    title: string;
    description: string;
  };
  about: {
    name: string;
    projects: string;
    livesIn: string;
    experience: string;
    expertise: string[];
    industries: string[];
  };
  competencies: { title: string; desc: string }[];
  tools: string[];
}

const aboutData: AboutType = {
  title: "About Me",
  mission: {
    title: "My Mission",
    description:
      "I build scalable, real-time platforms for enterprises and educational institutions. 10+ years delivering WebRTC systems, cybersecurity tools, and business intelligence solutions.<br><br>Explore my <a href='/projects' class='text-cyber-blue hover:text-white transition-colors font-semibold'>project portfolio</a> or learn about my <a href='/services' class='text-cyber-blue hover:text-white transition-colors font-semibold'>services</a>.",
  },
  about: {
    name: "Muhammad Asif Javed",
    projects: "9+",
    livesIn: "Walton, Lahore, PK",
    experience: "10+ years",
    expertise: [
      "React/Next.js",
      "Node.js/Express", 
      "WebRTC/OpenVidu",
      "MongoDB/PostgreSQL",
      "Docker/AWS",
      "Socket.io/Redis",
      "Full-Stack Development",
      "WebRTC & Real-time Systems",
      "Interactive Display Technology",
      "Platform Integration",
      "Solo Project Leadership",
      "Cross-platform Development",
    ],
    industries: ["EdTech", "Real-time Systems", "Platform Integration", "Enterprise SaaS", "Interactive Displays", "Cybersecurity", "InsurTech", "Business Intelligence"],
  },
  competencies: [
    { title: "Full-Stack Development", desc: "React to cloud, enterprise-scale" },
    { title: "Real-time Systems", desc: "WebRTC casting & Socket.io collaboration" },
    { title: "Platform Integration", desc: "4000+ apps connected via APIs" },
    { title: "Solo Development", desc: "Enterprise platforms built & run solo for years" },
  ],
  tools: ["React & Next.js", "Node.js", "MongoDB", "WebRTC & OpenVidu", "DigitalOcean", "Socket.io & Fabric.js"],
};
---

<section
  id="about"
  class="bg-cyber-dark/60 py-24 relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-6">
    <div
      class="absolute w-96 h-96 bg-cyber-blue/5 rounded-full blur-3xl -bottom-20 -right-20"
    ></div>

    <div class="text-center mb-12">
      <p class="section-kicker mb-3">About</p>
      <h2 class="text-3xl md:text-4xl font-semibold">
        {aboutData.title}
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-16 items-center mb-24">
      <div class="relative">
        <div
          class="absolute inset-0 bg-cyber-blue/5 rounded-xl blur-md"
        ></div>
        <div
          class="border border-cyber-blue/20 bg-cyber-dark/50 backdrop-blur-sm rounded-xl p-6 relative"
        >
          <div class="flex items-center mb-6">
            <div class="w-3 h-3 rounded-full bg-red-500 mr-2"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500 mr-2"></div>
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
            <div class="ml-4 text-cyber-blue text-sm">developer.toml</div>
          </div>

          <div class="font-mono text-sm">
            <div class="mb-3">
              <span class="text-gray-500"># Developer Profile</span>
            </div>
            <div class="mb-3">
              <span class="text-orange-400">[developer]</span>
            </div>
            <div class="mb-2">
              <span class="text-green-400">name</span>{" "}
              <span class="text-gray-400">=</span>{" "}
              <span class="text-blue-300">"{aboutData.about.name}"</span>
            </div>
            <div class="mb-2">
              <span class="text-green-400">location</span>{" "}
              <span class="text-gray-400">=</span>{" "}
              <span class="text-blue-300">"{aboutData.about.livesIn}"</span>
            </div>
            <div class="mb-2">
              <span class="text-green-400">experience</span>{" "}
              <span class="text-gray-400">=</span>{" "}
              <span class="text-blue-300">"{aboutData.about.experience}"</span>
            </div>
            <div class="mb-4">
              <span class="text-green-400">projects_delivered</span>{" "}
              <span class="text-gray-400">=</span>{" "}
              <span class="text-purple-400">{aboutData.about.projects}</span>
            </div>
            <div class="mb-2">
              <span class="text-green-400">stack</span>{" "}
              <span class="text-gray-400">=</span>{" "}
              <span class="text-orange-400">[</span>
            </div>
            <div class="mb-2 pl-4">
              {aboutData.about.expertise.map((tech, index) => (
                <span>
                  <span class="text-blue-300">"{tech}"</span>
                  {index < aboutData.about.expertise.length - 1 && <span class="text-gray-400">, </span>}
                </span>
              ))}
            </div>
            <div class="mb-4">
              <span class="text-orange-400">]</span>
            </div>
            <div class="mb-2">
              <span class="text-green-400">specializes_in</span>{" "}
              <span class="text-gray-400">=</span>{" "}
              <span class="text-orange-400">[</span>
            </div>
            <div class="mb-2 pl-4">
              {aboutData.about.industries.map((industry, index) => (
                <span>
                  <span class="text-blue-300">"{industry}"</span>
                  {index < aboutData.about.industries.length - 1 && <span class="text-gray-400">, </span>}
                </span>
              ))}
            </div>
            <div>
              <span class="text-orange-400">]</span>
            </div>
          </div>
        </div>
      </div>

      <div>
        <h3 class="text-2xl font-bold mb-6 text-cyber-blue">
          {aboutData.mission.title}
        </h3>
        <p class="text-gray-300 mb-6" set:html={aboutData.mission.description}></p>

        <h3 class="text-2xl font-bold mb-6 text-cyber-blue">
          Core Competencies
        </h3>

        <div class="grid sm:grid-cols-2 gap-4 mb-8">
          {aboutData.competencies.map((comp) => (
            <div class="glass-card p-4">
              <div class="text-white font-semibold mb-1">{comp.title}</div>
              <div class="text-sm text-gray-400">{comp.desc}</div>
            </div>
          ))}
        </div>

        <div class="flex flex-wrap gap-3 mt-8">
          {aboutData.tools.map((tool) => (
            <span
              class="px-4 py-2 bg-cyber-blue/10 border border-cyber-blue/30 rounded-full text-cyber-blue text-sm"
            >
              {tool}
            </span>
          ))}
        </div>
      </div>
    </div>

    <Timeline />
    <Counter />
  </div>
</section>
