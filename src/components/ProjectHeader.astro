---
interface Props {
  title: string;
  // callers pass either a URL string or a content-collection image object
  image?: string | { src: string; alt?: string };
  variant?: 'hero' | 'card';
  size?: 'sm' | 'md' | 'lg';
}

const {
  title,
  image,
  variant = 'hero',
  size = 'lg'
} = Astro.props;

const selectedBg =
  (typeof image === "string" ? image : image?.src) || "/img/og-image.jpg";

// Define size classes
const sizeClasses = {
  sm: 'h-32',
  md: 'h-48', 
  lg: 'h-96'
};

const textSizeClasses = {
  sm: 'text-lg md:text-xl',
  md: 'text-xl md:text-2xl',
  lg: 'text-4xl md:text-6xl'
};

const containerClasses = variant === 'hero' 
  ? 'relative overflow-hidden pt-12 md:pt-16 mb-6'
  : 'relative overflow-hidden';

const wrapperClasses = variant === 'hero'
  ? 'relative mx-auto max-w-4xl px-6 pt-24'
  : 'relative';

const innerClasses = variant === 'hero'
  ? 'mx-auto max-w-4xl text-center'
  : 'text-center';

const sectionId = variant === 'hero' ? 'article-header' : undefined;
---

<section
  id={sectionId}
  class={containerClasses}
>
  <div class={wrapperClasses}>
    <div class={innerClasses}>
      <!-- Background image (card images carry their own baked-in title; hero adds an h1 overlay) -->
      <div
        class={`${sizeClasses[size]} overflow-hidden ${variant === 'hero' ? 'rounded-xl border border-cyber-blue/20 glow' : 'rounded-t-xl'} relative ${variant === 'card' ? 'bg-cover bg-center transition-transform duration-500 group-hover:scale-110' : ''}`}
        style={`background-image: url('${selectedBg}'); background-size: cover; background-position: center;`}
        role={variant === 'card' ? 'img' : undefined}
        aria-label={variant === 'card' ? title : undefined}
      >
        {variant === 'hero' && (
          <>
            <!-- Dark overlay for text readability -->
            <div class="absolute inset-0 bg-black/50"></div>

            <!-- Project name overlay -->
            <div class="absolute inset-0 flex items-center justify-center">
              <h1 class={`${textSizeClasses[size]} font-bold text-white text-center px-4 drop-shadow-2xl`}>
                {title}
              </h1>
            </div>
          </>
        )}
      </div>
    </div>
  </div>
</section>
