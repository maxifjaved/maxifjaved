---
import Icon from "./Icon.astro";

interface Props {
  author: {
    name: string;
    bio: string;
    avatar: string;
    social?: {
      linkedin?: string;
      github?: string;
    };
  };
}

const { author } = Astro.props;
---

<aside class="flex items-start gap-4 border-t border-line pt-6">
  <img
    src="/profile-image-112.jpg"
    alt={author.name}
    width="56"
    height="56"
    loading="lazy"
    class="h-14 w-14 rounded-full border border-line object-cover"
  />
  <div class="min-w-0">
    <p class="eyebrow">Written by</p>
    <p class="mt-1 font-medium text-ink">{author.name}</p>
    <p class="mt-0.5 text-sm leading-relaxed text-ink-2">{author.bio}</p>
    <div class="mt-2 flex gap-4">
      <a
        href="https://github.com/maxifjaved"
        rel="noopener"
        class="inline-flex items-center gap-1.5 text-sm text-ink-2 hover:text-ink transition-colors"
      >
        <Icon name="github" size={14} /> GitHub
      </a>
      <a
        href="https://www.linkedin.com/in/maxifjaved"
        rel="noopener"
        class="inline-flex items-center gap-1.5 text-sm text-ink-2 hover:text-ink transition-colors"
      >
        <Icon name="linkedin" size={14} /> LinkedIn
      </a>
    </div>
  </div>
</aside>
