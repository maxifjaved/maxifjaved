---
export interface PageData {
  title: string;
  subtitle: string;
  content: string;
  lastUpdated: string;
}

interface Props {
  pageData: PageData;
  sectionId?: string;
}

const { pageData, sectionId = pageData.title.toLowerCase().replace(/\s+/g, '-') } = Astro.props;
---

<section
  id={sectionId}
  class="shell pb-20"
  aria-labelledby={`${sectionId}-title`}
>
  <header class="max-w-3xl pt-10 sm:pt-14">
    <h1 id={`${sectionId}-title`} class="display text-4xl sm:text-5xl text-ink">
      {pageData.title}
    </h1>
    <p class="mt-5 max-w-2xl font-display text-lg leading-relaxed text-ink-2">
      {pageData.subtitle}
    </p>
    <p class="mt-4 font-mono text-xs text-ink-3">
      <span class="uppercase tracking-wide">Last updated</span> {pageData.lastUpdated}
    </p>
  </header>
  <div class="post-content mt-10" set:html={pageData.content} />
</section>
