---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import MainLayout from "../../layouts/MainLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import SocialShare from "../../components/SocialShare.astro";
import AuthorInfo from "../../components/AuthorInfo.astro";
import Icon from "../../components/Icon.astro";

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');

  return projectEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'projects'>;
};

const { entry } = Astro.props;
const { Content } = await entry.render();

const {
  title,
  description,
  category,
  status,
  startDate,
  endDate,
  duration,
  role,
  teamSize,
  technologies,
  businessContext,
  keyFeatures,
  metrics,
  images,
  seo,
  links,
} = entry.data;

const canonicalUrl = `https://maxifjaved.com/projects/${entry.slug}`;

// Titles are stored as "Name - Long descriptor"
const [name, ...titleRest] = title.split(" - ");
const subtitle = titleRest.join(" - ");

const startYear = startDate.slice(0, 4);
const endYear = endDate.slice(0, 4);
const span =
  status === "in-progress"
    ? `${startYear} — ongoing`
    : startYear === endYear
      ? endYear
      : `${startYear} — ${endYear}`;

// Related projects: the next 3 in a stable rotation. Because selection is a
// pure rotating window, every project is the "next-N" of exactly 3 predecessors,
// so each detail page gets exactly 3 inbound links — no orphan pages.
const orderedProjects = (await getCollection('projects')).sort((a, b) =>
  b.data.endDate.localeCompare(a.data.endDate) || a.slug.localeCompare(b.slug)
);
const selfIndex = orderedProjects.findIndex(p => p.slug === entry.slug);
const relatedProjects = [
  ...orderedProjects.slice(selfIndex + 1),
  ...orderedProjects.slice(0, selfIndex),
].slice(0, 3);

const authorData = {
  name: "Muhammad Asif Javed",
  bio: "AI platform engineer & full-stack developer with 10+ years of solo, end-to-end platform work",
  avatar: "https://maxifjaved.com/profile-image.jpg",
};

const projectLinks = [
  { href: links.liveUrl, label: "Live project" },
  { href: links.companyUrl, label: "Company" },
  { href: links.caseStudyUrl, label: "Case study" },
  { href: links.demoUrl, label: "Demo" },
].filter((l) => l.href);

const breadcrumbItems = [
  { name: "Home", url: "https://maxifjaved.com" },
  { name: "Work", url: "https://maxifjaved.com/projects" },
  { name: name, url: canonicalUrl },
];

// OG Image URL (frontmatter card images live on as social images only)
const ogImageUrl = images.featuredImage.src.startsWith('http')
  ? images.featuredImage.src
  : `https://maxifjaved.com${images.featuredImage.src}`;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: title,
  description: description,
  applicationCategory: category,
  image: {
    "@type": "ImageObject",
    url: ogImageUrl,
    width: "1200",
    height: "630",
    caption: images.featuredImage.alt || title
  },
  author: {
    "@type": "Person",
    name: authorData.name,
    jobTitle: "AI Platform Engineer & Full-Stack Developer"
  },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD"
  },
  operatingSystem: "Web",
  softwareVersion: "1.0"
};

const meta = [
  { label: "Role", value: role },
  { label: "Timeline", value: `${span} · ${duration}` },
  { label: "Team", value: teamSize },
  { label: "Industry", value: businessContext.industry },
  { label: "Client", value: businessContext.client },
  { label: "Users", value: businessContext.userBase },
];
---

<MainLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords.join(", ")}
  ogImage={ogImageUrl}
  canonicalUrl={canonicalUrl}
  ogTitle={seo.title}
  ogDescription={seo.description}
  ogType="article"
  twitterCard="summary_large_image"
  twitterTitle={seo.title}
  twitterDescription={seo.description}
  twitterImage={ogImageUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <Breadcrumb items={breadcrumbItems} />

  <article class="shell pb-20">
    <!-- Header -->
    <header class="max-w-3xl pt-10 sm:pt-14">
      <h1 class="display text-4xl sm:text-5xl text-ink">{name}</h1>
      {subtitle && (
        <p class="display mt-3 text-xl sm:text-2xl text-ink-2"><em>{subtitle}</em></p>
      )}
      <p class="mt-6 font-display text-lg leading-relaxed text-ink-2">
        {description}
      </p>
    </header>

    <!-- Meta grid -->
    <dl class="mt-10 grid grid-cols-2 gap-x-8 gap-y-5 border-t border-line pt-6 sm:grid-cols-3">
      {meta.map((m) => (
        <div>
          <dt class="figure-label">{m.label}</dt>
          <dd class="mt-1 text-sm leading-relaxed text-ink">{m.value}</dd>
        </div>
      ))}
      <div class="col-span-2 sm:col-span-3">
        <dt class="figure-label">Stack</dt>
        <dd class="mt-1 font-mono text-xs leading-relaxed text-ink-2">
          {technologies.join(" · ")}
        </dd>
      </div>
    </dl>

    <!-- Verified figures -->
    {metrics.length > 0 && (
      <dl class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-4">
        {metrics.map((metric) => (
          <div class="bg-paper-2 p-5">
            <dd class="figure-value text-2xl">{metric.value}</dd>
            <dt class="mt-1.5 figure-label">{metric.label}</dt>
            <p class="mt-1.5 text-xs leading-relaxed text-ink-2">{metric.description}</p>
          </div>
        ))}
      </dl>
    )}

    {projectLinks.length > 0 && (
      <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
        {projectLinks.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener noreferrer"
            class="link inline-flex items-center gap-1.5 text-[0.9375rem]"
          >
            {l.label} <Icon name="external" size={14} />
          </a>
        ))}
      </p>
    )}

    <!-- Case study body -->
    <div class="post-content mt-12">
      <Content />
    </div>

    <!-- Feature index -->
    {keyFeatures.length > 0 && (
      <section class="mt-14 max-w-3xl">
        <h2 class="eyebrow">Feature index</h2>
        <ul class="mt-4 grid gap-x-8 gap-y-2.5 sm:grid-cols-2">
          {keyFeatures.map((feature) => (
            <li class="border-t border-line pt-2.5 text-sm leading-relaxed text-ink-2">
              {feature}
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="mt-14 max-w-3xl space-y-8">
      <SocialShare title={title} url={canonicalUrl} />
      <AuthorInfo author={authorData} />
    </div>

    <!-- More work -->
    <section class="mt-16">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="eyebrow">More work</h2>
        <a href="/projects" class="link text-sm">All work</a>
      </div>
      <div class="mt-4">
        {relatedProjects.map((rp) => (
          <a
            href={`/projects/${rp.slug}`}
            class="group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-t border-line py-4"
          >
            <span class="display text-lg text-ink group-hover:text-accent transition-colors">
              {rp.data.title.split(" - ")[0]}
            </span>
            <span class="figure-label">
              {rp.data.status === "in-progress"
                ? `${rp.data.startDate.slice(0, 4)} — now`
                : rp.data.endDate.slice(0, 4)}
            </span>
          </a>
        ))}
      </div>
    </section>
  </article>
</MainLayout>
