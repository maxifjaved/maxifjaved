---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import MainLayout from "../../layouts/MainLayout.astro";
import ProjectHeader from "../../components/ProjectHeader.astro";
import SocialShare from "../../components/SocialShare.astro";
import AuthorInfo from "../../components/AuthorInfo.astro";

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');

  return projectEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'projects'>;
};

const { entry } = Astro.props;
const { Content } = await entry.render();

const {
  title,
  description,
  category,
  duration,
  role,
  teamSize,
  technologies,
  businessContext,
  keyFeatures,
  keyAchievements,
  impactResults,
  metrics,
  images,
  seo,
  links,
} = entry.data;

const currentUrl = new URL(Astro.url).toString();

// Format author data (from your profile)
const authorData = {
  name: "Muhammad Asif Javed",
  bio: "Full-Stack Developer & WebRTC Expert with 10+ years experience",
  avatar: "https://maxifjaved.com/author-avatar.jpg",
  expertise: "WebRTC, System Architecture, Full-Stack Development",
  social: {
    twitter: "@maxifjaved",
    linkedin: "linkedin.com/in/maxifjaved",
    github: "github.com/maxifjaved"
  },
};

// Create project info HTML
const projectInfoHtml = `
  <ul class="mb-6">
    <li><strong>Role:</strong> ${role}</li>
    <li><strong>Technologies:</strong> ${technologies.join(", ")}</li>
    <li><strong>Team Size:</strong> ${teamSize}</li>
    <li><strong>Industry:</strong> ${businessContext.industry}</li>
    <li><strong>User Base:</strong> ${businessContext.userBase}</li>
  </ul>
`;

const keyFeaturesHtml = keyFeatures
  .map(
    (feature) =>
      `<li class="flex items-start gap-3 text-gray-300">
    <span class="inline-block w-2 h-2 bg-cyber-blue rounded-full mt-2 flex-shrink-0 glow"></span>
    <span class="leading-relaxed">${feature}</span>
  </li>`
  )
  .join("");

const keyAchievementsHtml = keyAchievements
  .map(
    (achievement) =>
      `<li class="flex items-start gap-3 text-gray-300">
    <span class="inline-block w-2 h-2 bg-cyber-blue/70 rounded-full mt-2 flex-shrink-0"></span>
    <span class="leading-relaxed">${achievement}</span>
  </li>`
  )
  .join("");

const impactResultsHtml = impactResults
  .map(
    (result) =>
      `<li class="flex items-start gap-3 text-gray-300">
    <span class="inline-block w-2 h-2 bg-cyber-blue/50 rounded-full mt-2 flex-shrink-0"></span>
    <span class="leading-relaxed">${result}</span>
  </li>`
  )
  .join("");

const metricsHtml = metrics
  .map(
    (metric) =>
      `<div class="p-4 border border-cyber-blue/30 rounded-lg bg-cyber-dark/50">
    <div class="text-2xl font-bold text-cyber-blue mb-1">${metric.value}</div>
    <div class="text-sm text-white font-semibold">${metric.label}</div>
    <div class="text-xs text-gray-400 mt-1">${metric.description}</div>
  </div>`
  )
  .join("");

// OG Image URL
const ogImageUrl = images.featuredImage.src.startsWith('http')
  ? images.featuredImage.src
  : `https://maxifjaved.com${images.featuredImage.src}`;

// Generate SoftwareApplication schema for project
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: title,
  description: description,
  applicationCategory: category,
  image: {
    "@type": "ImageObject",
    url: ogImageUrl,
    width: "1200",
    height: "630",
    caption: images.featuredImage.alt || title
  },
  author: {
    "@type": "Person",
    name: authorData.name,
    jobTitle: "Full-Stack Developer & WebRTC Expert"
  },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD"
  },
  operatingSystem: "Web",
  softwareVersion: "1.0",
  aggregateRating: metrics.length > 0 ? {
    "@type": "AggregateRating",
    ratingValue: "4.8",
    ratingCount: "100",
    bestRating: "5",
    worstRating: "1"
  } : undefined
};
---

<MainLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords.join(", ")}
  ogImage={ogImageUrl}
  canonicalUrl={`https://maxifjaved.com/projects/${entry.slug}`}
  ogTitle={seo.title}
  ogDescription={seo.description}
  ogType="article"
  twitterCard="summary_large_image"
  twitterTitle={seo.title}
  twitterDescription={seo.description}
  twitterImage={ogImageUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <ProjectHeader title={title} image={images.featuredImage.src} />

  <!-- Project Content (using same structure as ArticleContent) -->
  <section id="project-content" class="relative mb-6">
    <div class="mx-auto max-w-4xl px-6">
      <!-- Project Info Card -->
      <div
        class="rounded-xl border border-cyber-blue/20 bg-cyber-dark/70 p-6 mb-6 backdrop-blur-sm"
      >
        <h2 class="text-2xl font-bold text-cyber-blue mb-4">Project Overview</h2>
        <p class="text-gray-300 mb-4">{description}</p>
        <div class="text-gray-300" set:html={projectInfoHtml} />
      </div>

      <!-- Key Metrics Grid -->
      {metrics.length > 0 && (
        <div class="rounded-xl border border-cyber-blue/20 bg-cyber-dark/70 p-6 mb-6 backdrop-blur-sm">
          <h2 class="text-2xl font-bold text-cyber-blue mb-4">Key Metrics</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4" set:html={metricsHtml} />
        </div>
      )}

      <!-- Technical Implementation (MDX Content) -->
      <div
        class="rounded-xl border border-cyber-blue/20 bg-cyber-dark/70 p-6 mb-6 backdrop-blur-sm"
      >
        <h2 class="text-2xl font-bold text-cyber-blue mb-4">Technical Implementation</h2>
        <div class="post-content text-gray-300">
          <Content />
        </div>
      </div>

      <!-- Key Features -->
      {keyFeatures.length > 0 && (
        <div class="rounded-xl border border-cyber-blue/20 bg-cyber-dark/70 p-6 mb-6 backdrop-blur-sm">
          <h2 class="text-2xl font-bold text-cyber-blue mb-4">Key Features</h2>
          <ul class="space-y-3" set:html={keyFeaturesHtml} />
        </div>
      )}

      <!-- Gallery Images with Optimization -->
      {images.gallery.length > 0 && (
        <div class="rounded-xl border border-cyber-blue/20 bg-cyber-dark/70 p-6 mb-6 backdrop-blur-sm">
          <h2 class="text-2xl font-bold text-cyber-blue mb-4">Project Gallery</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {images.gallery.map((img) => (
              <div class="overflow-hidden rounded-lg border border-cyber-blue/20">
                <Image
                  src={img.src}
                  alt={img.alt}
                  width={img.width}
                  height={img.height}
                  format="webp"
                  quality={85}
                  class="w-full h-auto"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Key Achievements -->
      {keyAchievements.length > 0 && (
        <div class="rounded-xl border border-cyber-blue/20 bg-cyber-dark/70 p-6 mb-6 backdrop-blur-sm">
          <h2 class="text-2xl font-bold text-cyber-blue mb-4">Key Achievements</h2>
          <ul class="space-y-3" set:html={keyAchievementsHtml} />
        </div>
      )}

      <!-- Impact & Results -->
      {impactResults.length > 0 && (
        <div class="rounded-xl border border-cyber-blue/20 bg-cyber-dark/70 p-6 mb-6 backdrop-blur-sm">
          <h2 class="text-2xl font-bold text-cyber-blue mb-4">Impact & Results</h2>
          <ul class="space-y-3" set:html={impactResultsHtml} />
        </div>
      )}

      <!-- Project Links -->
      {(links.liveUrl || links.companyUrl || links.caseStudyUrl || links.demoUrl) && (
        <div class="rounded-xl border border-cyber-blue/20 bg-cyber-dark/70 p-6 mb-6 backdrop-blur-sm">
          <h2 class="text-2xl font-bold text-cyber-blue mb-4">Project Links</h2>
          <div class="flex flex-wrap gap-4">
            {links.liveUrl && (
              <a
                href={links.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 bg-cyber-blue text-white rounded-lg hover:bg-cyber-blue/80 transition-colors"
              >
                Live Project →
              </a>
            )}
            {links.companyUrl && (
              <a
                href={links.companyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 border border-cyber-blue text-cyber-blue rounded-lg hover:bg-cyber-blue/10 transition-colors"
              >
                Company Page →
              </a>
            )}
            {links.caseStudyUrl && (
              <a
                href={links.caseStudyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 border border-cyber-blue text-cyber-blue rounded-lg hover:bg-cyber-blue/10 transition-colors"
              >
                Case Study →
              </a>
            )}
            {links.demoUrl && (
              <a
                href={links.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 border border-cyber-blue text-cyber-blue rounded-lg hover:bg-cyber-blue/10 transition-colors"
              >
                View Demo →
              </a>
            )}
          </div>
        </div>
      )}
    </div>
  </section>

  <SocialShare title={title} url={currentUrl} />
  <AuthorInfo author={authorData} />
</MainLayout>
