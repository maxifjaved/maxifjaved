---
import AboutHero from "../components/AboutHero.astro";
import PersonalStory from "../components/PersonalStory.astro";
import TechnicalExpertise from "../components/TechnicalExpertise.astro";
import WorkingApproach from "../components/WorkingApproach.astro";
import CTA from "../components/CTA.astro";
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const breadcrumbItems = [
  { name: "Home", url: "https://maxifjaved.com" },
  { name: "About", url: "https://maxifjaved.com/about" }
];
---

<MainLayout
  title="About Muhammad Asif Javed - WebRTC Expert"
  description="10+ years building enterprise WebRTC platforms, real-time systems, and cybersecurity solutions. Based in Lahore, Pakistan."
  keywords="Muhammad Asif Javed biography, WebRTC expert background, full-stack developer experience, real-time systems specialist, Lahore Pakistan developer story, solo developer expertise"
>
    <Breadcrumb items={breadcrumbItems} />
    <AboutHero />
    <PersonalStory />
    <TechnicalExpertise />
    <WorkingApproach />
    <CTA />
</MainLayout>