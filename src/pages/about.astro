---
import AboutHero from "../components/AboutHero.astro";
import PersonalStory from "../components/PersonalStory.astro";
import TechnicalExpertise from "../components/TechnicalExpertise.astro";
import WorkingApproach from "../components/WorkingApproach.astro";
import CTA from "../components/CTA.astro";
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const breadcrumbItems = [
  { name: "Home", url: "https://maxifjaved.com" },
  { name: "About", url: "https://maxifjaved.com/about" }
];

// ProfilePage marks /about as the canonical profile surface; mainEntity
// resolves to the Person entity in MainLayout's schema graph.
const profilePageSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://maxifjaved.com/about#profilepage",
  "name": "About Muhammad Asif Javed - WebRTC Expert & Full-Stack Developer",
  "url": "https://maxifjaved.com/about",
  "mainEntity": { "@id": "https://maxifjaved.com/#person" }
};
---

<MainLayout
  title="About Muhammad Asif Javed - WebRTC Expert"
  description="10+ years building enterprise WebRTC platforms, real-time systems, and cybersecurity solutions. Based in Lahore, Pakistan."
  keywords="Muhammad Asif Javed biography, WebRTC expert background, full-stack developer experience, real-time systems specialist, Lahore Pakistan developer story, solo developer expertise"
>
    <script type="application/ld+json" set:html={JSON.stringify(profilePageSchema)} />
    <Breadcrumb items={breadcrumbItems} />
    <AboutHero />
    <PersonalStory />
    <TechnicalExpertise />
    <WorkingApproach />
    <CTA />
</MainLayout>