---
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const breadcrumbItems = [
  { name: "Home", url: "https://maxifjaved.com" },
  { name: "Uses", url: "https://maxifjaved.com/uses" }
];

const computer = {
  name: "Mac mini 2024",
  specs: [
    { label: "Chip", value: "Apple M4 Pro" },
    { label: "Memory", value: "48 GB" },
    { label: "Storage", value: "1 TB SSD" },
    { label: "OS", value: "macOS Tahoe" }
  ]
};

const sections = [
  {
    title: "Desk",
    items: [
      { name: "Google P2718QC", category: "Monitor ×2" },
      { name: "Logitech MX Master 4", category: "Mouse" },
      { name: "Logitech MX Keys Mini", category: "Keyboard" },
      { name: "Logitech C922 Pro", category: "Webcam" },
      { name: "Boya PM500", category: "Microphone" },
      { name: "Gionee Handfree", category: "Headphones" }
    ]
  },
  {
    title: "Development",
    items: [
      { name: "WebStorm", category: "JavaScript/TypeScript IDE" },
      { name: "PyCharm", category: "Python IDE" },
      { name: "PhpStorm", category: "PHP IDE" },
      { name: "DataGrip", category: "Database IDE" },
      { name: "WezTerm", category: "Terminal emulator" },
      { name: "Docker", category: "Containerization" },
      { name: "Ollama", category: "Local LLMs" },
      { name: "MAMP Pro", category: "Local server environment" },
      { name: "Claude Code", category: "AI coding assistant" }
    ]
  },
  {
    title: "Productivity",
    items: [
      { name: "Notion", category: "Notes & documentation" },
      { name: "1Password", category: "Password manager" },
      { name: "Raycast", category: "Launcher & productivity" },
      { name: "Karabiner-Elements", category: "Keyboard customization" },
      { name: "CleanShot X", category: "Screenshots & recording" }
    ]
  },
  {
    title: "Cloud & browsers",
    items: [
      { name: "Cloudflare", category: "CDN & DNS" },
      { name: "AWS", category: "Cloud infrastructure" },
      { name: "Google Cloud Platform", category: "Cloud services" },
      { name: "Arc", category: "Primary browser" },
      { name: "Brave", category: "Secondary browser" }
    ]
  }
];
---

<MainLayout
  title="Uses - Muhammad Asif Javed | Hardware & Software Setup"
  description="The hardware, software, and services Muhammad Asif Javed uses daily: Mac mini M4 Pro, JetBrains IDEs, Docker, Ollama, and more."
  keywords="developer setup, uses page, Mac mini M4 Pro, WebStorm setup, developer tools 2026"
  canonicalUrl="https://maxifjaved.com/uses"
>
  <Breadcrumb items={breadcrumbItems} />

  <section class="shell pb-20">
    <header class="max-w-3xl pt-10 sm:pt-14">
      <p class="eyebrow">Uses</p>
      <h1 class="display mt-3 text-4xl sm:text-5xl text-ink">
        The tools I <em>work with.</em>
      </h1>
      <p class="mt-5 max-w-2xl font-display text-lg leading-relaxed text-ink-2">
        Hardware, software, and services in daily rotation — the whole stack
        behind the work on this site.
      </p>
    </header>

    <!-- Machine -->
    <section class="mt-12" aria-labelledby="machine-title">
      <h2 id="machine-title" class="eyebrow">Machine · {computer.name}</h2>
      <dl class="mt-4 grid grid-cols-2 gap-y-5 border-y border-line py-5 sm:grid-cols-4">
        {computer.specs.map((spec) => (
          <div class="pr-6">
            <dd class="figure-value text-lg">{spec.value}</dd>
            <dt class="mt-1 figure-label">{spec.label}</dt>
          </div>
        ))}
      </dl>
    </section>

    {sections.map((section) => (
      <section class="mt-12" aria-label={section.title}>
        <h2 class="eyebrow">{section.title}</h2>
        <ul class="mt-4 grid gap-x-10 sm:grid-cols-2">
          {section.items.map((item) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-4 border-t border-line py-2.5">
              <span class="font-medium text-ink">{item.name}</span>
              <span class="text-sm text-ink-2">{item.category}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</MainLayout>
