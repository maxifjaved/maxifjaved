---
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const breadcrumbItems = [
  { name: "Home", url: "https://maxifjaved.com" },
  { name: "Uses", url: "https://maxifjaved.com/uses" }
];

const computer = {
  name: "Mac mini 2024",
  specs: [
    { label: "Chip", value: "Apple M4 Pro" },
    { label: "Memory", value: "48 GB" },
    { label: "Storage", value: "1 TB SSD" },
    { label: "OS", value: "macOS Tahoe" }
  ]
};

const peripherals = [
  {
    name: "Google P2718QC",
    category: "Monitor (x2)",
    icon: "fa-display"
  },
  {
    name: "Logitech MX Master 4",
    category: "Mouse",
    icon: "fa-computer-mouse"
  },
  {
    name: "Logitech MX Keys Mini",
    category: "Keyboard",
    icon: "fa-keyboard"
  }
];

const audioVideo = [
  {
    name: "Logitech C922 Pro",
    category: "Webcam",
    icon: "fa-video"
  },
  {
