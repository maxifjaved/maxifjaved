  {
    name: "Cloudflare",
    category: "CDN & DNS",
    icon: "fa-cloud"
  },
  {
    name: "AWS",
    category: "Cloud Infrastructure",
    icon: "fa-cloud"
  },
  {
    name: "Google Cloud Platform",
    category: "Cloud Services",
    icon: "fa-cloud"
  }
];

const browsers = [
  {
    name: "Arc",
    category: "Primary Browser",
    icon: "fa-globe"
  },
  {
    name: "Brave",
    category: "Secondary Browser",
    icon: "fa-shield"
