    category: "Terminal Emulator",
    icon: "fa-terminal"
  },
  {
    name: "Docker",
    category: "Containerization",
    icon: "fa-cube"
  },
  {
    name: "Ollama",
    category: "Local LLMs",
    icon: "fa-robot"
  },
  {
    name: "MAMP Pro",
    category: "Local Server Environment",
    icon: "fa-server"
  },
  {
    name: "Claude Code",
    category: "AI Coding Assistant",
    icon: "fa-wand-magic-sparkles"
  }
];

const productivity = [
  {
    name: "Notion",
    category: "Notes & Documentation",
    icon: "fa-book"
  },
  {
    name: "1Password",
    category: "Password Manager",
    icon: "fa-key"
  },
  {
    name: "Raycast",
    category: "Launcher & Productivity",
    icon: "fa-bolt"
  },
  {
    name: "Karabiner-Elements",
    category: "Keyboard Customization",
    icon: "fa-sliders"
  },
  {
    name: "CleanShot X",
    category: "Screenshot & Recording",
    icon: "fa-camera"
  }
];

