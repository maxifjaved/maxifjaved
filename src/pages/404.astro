---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="404 - Page Not Found | Muhammad Asif Javed"
  description="The page you're looking for doesn't exist. Navigate back to Muhammad Asif Javed's portfolio to explore projects, writing, and contact information."
  keywords="404 error, page not found, Muhammad Asif Javed"
>
  <section class="shell flex min-h-[60vh] flex-col justify-center py-24">
    <p class="figure-value text-sm">HTTP 404</p>
    <h1 class="display mt-4 max-w-2xl text-4xl sm:text-6xl text-ink">
      This page doesn&rsquo;t <em>exist.</em>
    </h1>
    <p class="mt-6 max-w-xl font-display text-lg leading-relaxed text-ink-2">
      The address may have changed in the last redesign. Everything worth
      finding is one link away.
    </p>
    <div class="mt-9 flex flex-wrap gap-4">
      <a href="/" class="btn btn-primary">Back to home</a>
      <a href="/projects" class="btn btn-quiet">View the work</a>
    </div>
  </section>
</MainLayout>
