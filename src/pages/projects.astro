---
import { getCollection } from 'astro:content';
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import WorkRow from "../components/WorkRow.astro";

const breadcrumbItems = [
  { name: "Home", url: "https://maxifjaved.com" },
  { name: "Work", url: "https://maxifjaved.com/projects" }
];

const CATEGORY_LABELS: Record<string, string> = {
  "edtech": "EdTech",
  "interactive-displays": "Interactive displays",
  "business-intelligence": "Business intelligence",
  "cybersecurity": "Cybersecurity",
  "insurance-tech": "Insurance",
  "ai-marketing": "AI marketing",
  "cloud-infrastructure": "Cloud infrastructure",
  "mobile-apps": "Mobile",
  "3d-visualization": "3D",
};

const allProjects = (await getCollection('projects')).sort((a, b) =>
  b.data.endDate.localeCompare(a.data.endDate) || a.slug.localeCompare(b.slug)
);

const categories = [...new Set(allProjects.map((p) => p.data.category))].sort();

const years = allProjects.flatMap((p) => [
  Number(p.data.startDate.slice(0, 4)),
  Number(p.data.endDate.slice(0, 4)),
]);
const spanYears = `${Math.min(...years)} — ${new Date().getFullYear()}`;

// ItemList Schema for projects listing page
const projectsListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": allProjects.map((project, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "CreativeWork",
      "name": project.data.title,
      "description": project.data.description,
      "image": project.data.images?.featuredImage?.src || "",
      "creator": {
        "@type": "Person",
        "name": "Muhammad Asif Javed"
      },
      "url": `https://maxifjaved.com/projects/${project.slug}`
    }
  }))
};
---

<MainLayout
  title="Work - Muhammad Asif Javed | AI, Real-Time & Enterprise Platforms"
  description="19 production platforms built end to end: AI marketing tools, real-time classroom collaboration, cybersecurity intelligence, MDM, and 3D configurators."
  keywords="AI platform portfolio, WebRTC projects, enterprise software examples, educational technology projects, cybersecurity platform development, full-stack developer portfolio"
  canonicalUrl="https://maxifjaved.com/projects"
>
  <script type="application/ld+json" set:html={JSON.stringify(projectsListSchema)} />
  <Breadcrumb items={breadcrumbItems} />

  <section class="shell pb-20">
    <header class="max-w-3xl pt-10 sm:pt-14">
      <p class="eyebrow">Index of work · {spanYears}</p>
      <h1 class="display mt-3 text-4xl sm:text-5xl text-ink">
        {allProjects.length} platforms, <em>built end to end.</em>
      </h1>
      <p class="mt-5 max-w-2xl font-display text-lg leading-relaxed text-ink-2">
        Every entry below is a production system I designed, built, and ran —
        backend, frontend, database, infrastructure, and deployment. Each case
        study is written from the source code, not from memory.
      </p>
    </header>

    <!-- Category filter — progressive enhancement; all rows render without JS -->
    <nav aria-label="Filter by category" class="mt-10 flex flex-wrap gap-2" data-filter-nav hidden>
      <button
        type="button"
        data-filter="all"
        aria-pressed="true"
        class="rounded-full border border-line-strong px-3.5 py-1.5 font-mono text-xs uppercase tracking-wide text-ink transition-colors hover:border-ink-2 aria-pressed:bg-ink aria-pressed:text-paper aria-pressed:border-ink"
      >
        All · {allProjects.length}
      </button>
      {categories.map((cat) => (
        <button
          type="button"
          data-filter={cat}
          aria-pressed="false"
          class="rounded-full border border-line-strong px-3.5 py-1.5 font-mono text-xs uppercase tracking-wide text-ink-2 transition-colors hover:border-ink-2 hover:text-ink aria-pressed:bg-ink aria-pressed:text-paper aria-pressed:border-ink"
        >
          {CATEGORY_LABELS[cat] ?? cat} · {allProjects.filter((p) => p.data.category === cat).length}
        </button>
      ))}
    </nav>

    <div class="mt-6 border-b border-line" data-work-list>
      {allProjects.map((project) => (
        <WorkRow
          slug={project.slug}
          title={project.data.title}
          summary={project.data.seo.description}
          category={project.data.category}
          startDate={project.data.startDate}
          endDate={project.data.endDate}
          status={project.data.status}
          technologies={project.data.technologies}
        />
      ))}
      <p class="hidden py-10 text-center text-sm text-ink-3" data-empty-note>
        No projects in this category.
      </p>
    </div>
  </section>

  <script>
    // Category filter. Without JS the nav stays hidden and all rows show.
    const nav = document.querySelector<HTMLElement>("[data-filter-nav]");
    if (nav) {
      nav.hidden = false;
      const buttons = nav.querySelectorAll<HTMLButtonElement>("[data-filter]");
      const rows = document.querySelectorAll<HTMLElement>(".work-row");

      const apply = (filter: string) => {
        buttons.forEach((b) =>
          b.setAttribute("aria-pressed", String(b.dataset.filter === filter))
        );
        let shown = 0;
        rows.forEach((row) => {
          const show = filter === "all" || row.dataset.category === filter;
          row.style.display = show ? "" : "none";
          if (show) shown++;
        });
        const empty = document.querySelector<HTMLElement>("[data-empty-note]");
        if (empty) empty.classList.toggle("hidden", shown > 0);
      };

      buttons.forEach((btn) =>
        btn.addEventListener("click", () => {
          const filter = btn.dataset.filter || "all";
          apply(filter);
          const url = new URL(window.location.href);
          if (filter === "all") url.searchParams.delete("category");
          else url.searchParams.set("category", filter);
          history.replaceState(null, "", url);
        })
      );

      const initial = new URLSearchParams(window.location.search).get("category");
      if (initial && [...buttons].some((b) => b.dataset.filter === initial)) {
        apply(initial);
      }
    }
  </script>
</MainLayout>
