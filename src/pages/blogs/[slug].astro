---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import MainLayout from "../../layouts/MainLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ArticleHeader from "../../components/ArticleHeader.astro";
import BlogSummary from "../../components/BlogSummary.astro";
import BlogTags from "../../components/BlogTags.astro";
import SocialShare from "../../components/SocialShare.astro";
import AuthorInfo from "../../components/AuthorInfo.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import BlogFAQ from "../../components/BlogFAQ.astro";
import BlogCitations from "../../components/BlogCitations.astro";

export async function getStaticPaths() {
  const blogEntries = await getCollection('blogs', ({ data }) => {
    return data.draft !== true;
  });

  return blogEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'blogs'>;
};

const { entry } = Astro.props;
const { Content } = await render(entry);

const {
  title,
  subtitle,
  description,
  author,
  date,
  lastUpdated,
  category,
  readTime,
  featuredImage,
  midArticleImage,
  keywords,
  canonicalUrl,
  tags,
  faqs,
  citations,
  relatedPosts,
  quickAnswer,
} = entry.data;

// SEO data
const keywordsString = keywords.join(", ");
const pageUrl = canonicalUrl || `https://maxifjaved.com/blogs/${entry.id}`;
const ogImageUrl = featuredImage.src.startsWith("http")
  ? featuredImage.src
  : `https://maxifjaved.com${featuredImage.src}`;

// Breadcrumb data
const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Writing", url: "/blogs" },
  { name: title, url: "" },
];

// Generate JSON-LD structured data for BlogPosting with enhanced ImageObject
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description,
  image: ogImageUrl,
  author: {
    "@type": "Person",
    name: author.name,
    jobTitle: author.title,
    knowsAbout: author.expertise_areas || [],
  },
  publisher: {
    "@type": "Person",
    name: author.name,
    logo: {
      "@type": "ImageObject",
      url: "https://maxifjaved.com/img/profile-image.jpg",
      width: "400",
      height: "400"
    }
  },
  datePublished: date.toISOString(),
  dateModified: (lastUpdated || date).toISOString(),
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": pageUrl,
  },
  keywords: keywordsString,
};

// Generate FAQ schema if FAQs exist
let faqSchema = null;
if (faqs && faqs.length > 0) {
  faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  };
}

// Generate HowTo schema for technical tutorial posts
let howToSchema = null;
const isTutorial = category === 'Tutorial' || title.toLowerCase().includes('how to') || title.toLowerCase().includes('guide');
if (isTutorial && faqs && faqs.length > 0) {
  howToSchema = {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: title,
    description: description,
    image: {
      "@type": "ImageObject",
      url: ogImageUrl,
      width: "1200",
      height: "630"
    },
    estimatedCost: {
      "@type": "MonetaryAmount",
      currency: "USD",
      value: "0"
    },
    step: faqs.map((faq, index) => ({
      "@type": "HowToStep",
      position: index + 1,
      name: faq.question,
      text: faq.answer
    }))
  };
}

const summaryMarkdown = quickAnswer || subtitle;

const authorData = {
  name: author.name,
  bio: author.bio,
  avatar: author.avatar || "https://maxifjaved.com/profile-image.jpg",
};

const featuredImageData = {
  src: featuredImage.src,
  alt: featuredImage.alt,
  caption: featuredImage.caption,
  width: featuredImage.width,
  height: featuredImage.height,
};
---

<MainLayout
  title={title}
  description={description}
  keywords={keywordsString}
  ogImage={ogImageUrl}
  canonicalUrl={pageUrl}
  ogTitle={title}
  ogDescription={description}
  ogType="article"
  twitterCard="summary_large_image"
  twitterTitle={title}
  twitterDescription={description}
  twitterImage={ogImageUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
  {howToSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  )}

  <Breadcrumb items={breadcrumbItems} />
  <ArticleHeader
    title={title}
    subtitle={subtitle}
    category={category}
    date={date}
    author={authorData}
    readTime={readTime}
    featuredImageData={featuredImageData}
  />

  <article class="shell pb-20">
    <div class="mt-10">
      {summaryMarkdown && <BlogSummary summary={summaryMarkdown} />}
    </div>

    <div class="post-content mt-10">
      <Content />
    </div>

    {midArticleImage && (
      <figure class="mt-10 max-w-3xl">
        <img
          src={midArticleImage.src}
          alt={midArticleImage.alt}
          width={midArticleImage.width}
          height={midArticleImage.height}
          loading="lazy"
          decoding="async"
          class="w-full rounded-lg border border-line"
        />
        {midArticleImage.caption && (
          <figcaption class="mt-3 text-sm italic text-ink-3">
            {midArticleImage.caption}
          </figcaption>
        )}
      </figure>
    )}

    <div class="mt-10 space-y-2">
      {tags.length > 0 && <BlogTags tags={tags} />}
      {lastUpdated && lastUpdated.toISOString() !== date.toISOString() && (
        <p class="font-mono text-xs text-ink-3">
          <span class="uppercase tracking-wide">Last updated</span>
          {" "}{lastUpdated.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </p>
      )}
    </div>

    <div class="mt-12 space-y-12">
      {faqs && <BlogFAQ faqs={faqs} />}
      {citations && <BlogCitations citations={citations} />}
      <div class="max-w-3xl space-y-8">
        <SocialShare title={title} url={pageUrl} />
        <AuthorInfo author={authorData} />
      </div>
      <RelatedPosts relatedPosts={relatedPosts || []} />
    </div>
  </article>
</MainLayout>
