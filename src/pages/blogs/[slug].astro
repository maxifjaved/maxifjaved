---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import MainLayout from "../../layouts/MainLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ArticleHeader from "../../components/ArticleHeader.astro";
import BlogSummary from "../../components/BlogSummary.astro";
import BlogTags from "../../components/BlogTags.astro";
import SocialShare from "../../components/SocialShare.astro";
import AuthorInfo from "../../components/AuthorInfo.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import BlogFAQ from "../../components/BlogFAQ.astro";
import BlogCitations from "../../components/BlogCitations.astro";

export async function getStaticPaths() {
  const blogEntries = await getCollection('blogs', ({ data }) => {
    return data.draft !== true;
  });

  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'blogs'>;
};

const { entry } = Astro.props;
const { Content } = await entry.render();

const {
  title,
  subtitle,
  description,
  author,
  date,
  lastUpdated,
  category,
  readTime,
  featuredImage,
  midArticleImage,
  keywords,
  canonicalUrl,
  tags,
  faqs,
  citations,
  relatedPosts,
  quickAnswer,
} = entry.data;

// SEO data
const keywordsString = keywords.join(", ");
const currentUrl = new URL(Astro.url).toString();
const ogImageUrl = featuredImage.src.startsWith("http")
  ? featuredImage.src
  : `https://maxifjaved.com${featuredImage.src}`;

// Breadcrumb data
const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Blog", url: "/blogs" },
  { name: title, url: "" },
];

// Generate JSON-LD structured data for BlogPosting
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description,
  image: ogImageUrl,
  author: {
    "@type": "Person",
    name: author.name,
    jobTitle: author.title,
    knowsAbout: author.expertise_areas || [],
  },
  publisher: {
    "@type": "Person",
    name: author.name,
  },
  datePublished: date.toISOString(),
  dateModified: (lastUpdated || date).toISOString(),
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl || `https://maxifjaved.com/blogs/${entry.slug}`,
  },
  keywords: keywordsString,
};

// Generate FAQ schema if FAQs exist
let faqSchema = null;
if (faqs && faqs.length > 0) {
  faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  };
}

// Build summary markdown if quickAnswer exists
const summaryMarkdown = quickAnswer || subtitle;

// Format author for components
const authorData = {
  name: author.name,
  bio: author.bio,
  avatar: author.avatar || "https://maxifjaved.com/author-avatar.jpg",
  expertise: author.expertise_areas?.join(", ") || "",
  social: author.social_links || {},
};

// Format featured image data
const featuredImageData = {
  src: featuredImage.src,
  alt: featuredImage.alt,
  caption: featuredImage.caption,
};
---

<MainLayout
  title={title}
  description={description}
  keywords={keywordsString}
  ogImage={ogImageUrl}
  canonicalUrl={canonicalUrl || `https://maxifjaved.com/blogs/${entry.slug}`}
  ogTitle={title}
  ogDescription={description}
  ogType="article"
  twitterCard="summary_large_image"
  twitterTitle={title}
  twitterDescription={description}
  twitterImage={ogImageUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <ArticleHeader
    title={title}
    subtitle={subtitle}
    category={category}
    date={date}
    author={authorData}
    readTime={readTime}
    featuredImageData={featuredImageData}
  />

  <Breadcrumb items={breadcrumbItems} />

  {summaryMarkdown && <BlogSummary summary={summaryMarkdown} />}

  <section id="article-content" class="relative mb-6">
    <div class="mx-auto max-w-4xl px-6">
      <div
        class="rounded-xl border border-cyber-blue/20 bg-cyber-dark/70 p-6 text-left backdrop-blur-sm"
      >
        <div class="post-content">
          <Content />
        </div>
      </div>
    </div>
  </section>

  {midArticleImage && (
    <section class="relative mb-6">
      <div class="mx-auto max-w-4xl px-6">
        <figure>
          <div class="overflow-hidden rounded-xl border border-cyber-blue/20">
            <Image
              src={midArticleImage.src}
              alt={midArticleImage.alt}
              width={midArticleImage.width}
              height={midArticleImage.height}
              format="webp"
              quality={90}
              class="w-full h-auto"
              loading="lazy"
              decoding="async"
            />
          </div>
          {midArticleImage.caption && (
            <figcaption class="mt-3 text-center text-sm text-gray-400 italic">
              {midArticleImage.caption}
            </figcaption>
          )}
        </figure>
      </div>
    </section>
  )}

  {tags.length > 0 && <BlogTags tags={tags} />}

  {lastUpdated && lastUpdated.toISOString() !== date.toISOString() && (
    <div class="mx-auto max-w-4xl px-6 mb-8">
      <p class="text-sm text-gray-400 text-center">
        <span class="text-cyber-blue font-semibold">Last Updated:</span>{" "}
        {lastUpdated.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </p>
    </div>
  )}

  {faqs && <BlogFAQ faqs={faqs} />}
  {citations && <BlogCitations citations={citations} />}

  <SocialShare title={title} url={currentUrl} />
  <AuthorInfo author={authorData} />
  <RelatedPosts relatedPosts={relatedPosts || []} />
</MainLayout>
