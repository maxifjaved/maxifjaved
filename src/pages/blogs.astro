---
import { getCollection } from 'astro:content';
import BlogPost from "../components/BlogPost.astro";
import MainLayout from "../layouts/MainLayout.astro";

// Get all blog posts from content collections
const allPosts = await getCollection('blogs', ({ data }) => {
  return data.draft !== true;
});

// Sort posts by date (newest first)
const sortedPosts = allPosts.sort((a, b) =>
  b.data.date.getTime() - a.data.date.getTime()
);

// Search and category filtering
const searchQuery = Astro.url.searchParams.get('search') || '';
const selectedCategory = Astro.url.searchParams.get('category');

let filteredPosts = sortedPosts;

// Apply search filter
if (searchQuery) {
  filteredPosts = filteredPosts.filter(post =>
    post.data.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
    post.data.subtitle.toLowerCase().includes(searchQuery.toLowerCase()) ||
    post.data.category.toLowerCase().includes(searchQuery.toLowerCase())
  );
}

// Apply category filter
if (selectedCategory) {
  filteredPosts = filteredPosts.filter(post =>
    post.data.category.toLowerCase() === selectedCategory.toLowerCase()
  );
}

// Pagination settings (after filtering)
const POSTS_PER_PAGE = 6;
const currentPage = parseInt(Astro.url.searchParams.get('page') || '1');
const totalPages = Math.ceil(filteredPosts.length / POSTS_PER_PAGE);
const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
const endIndex = startIndex + POSTS_PER_PAGE;
const paginatedPosts = filteredPosts.slice(startIndex, endIndex);

// Get unique categories for filter
const categories = [...new Set(allPosts.map(post => post.data.category))];

// Map content collection posts to format expected by BlogPost component
const mappedPosts = paginatedPosts.map(post => ({
  slug: post.slug,
  title: post.data.title,
  subtitle: post.data.subtitle,
  category: post.data.category,
  date: post.data.date.toISOString().split('T')[0],
  author: post.data.author,
  readTime: post.data.readTime,
  featuredImage: post.data.featuredImage.src,
  metaDescription: post.data.description,
}));

// Dynamic page title and description based on search/category
let pageTitle = "Blog Articles | Muhammad Asif Javed";
let pageDescription = "Technical articles on WebRTC, real-time systems, and full-stack development. Expert insights from 10+ years of experience.";

if (searchQuery && selectedCategory) {
  pageTitle = `"${searchQuery}" in ${selectedCategory} | Blog`;
  pageDescription = `Search results for "${searchQuery}" in ${selectedCategory} category`;
} else if (searchQuery) {
  pageTitle = `Search: "${searchQuery}" | Blog`;
  pageDescription = `Search results for "${searchQuery}" in blog articles`;
} else if (selectedCategory) {
  pageTitle = `${selectedCategory} Articles | Blog`;
  pageDescription = `Technical articles about ${selectedCategory}`;
} else if (currentPage > 1) {
  pageTitle = `Blog Articles - Page ${currentPage} | Muhammad Asif Javed`;
}

// ItemList Schema for blog listing page (SEO best practice 2025)
const blogListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": paginatedPosts.map((post, index) => ({
    "@type": "ListItem",
    "position": startIndex + index + 1,
    "item": {
      "@type": "BlogPosting",
      "headline": post.data.title,
      "description": post.data.subtitle,
      "image": post.data.featuredImage.src.startsWith('http')
        ? post.data.featuredImage.src
        : `https://maxifjaved.com${post.data.featuredImage.src}`,
      "datePublished": post.data.date.toISOString(),
      "author": {
        "@type": "Person",
        "name": post.data.author.name
      },
      "url": `https://maxifjaved.com/blogs/${post.slug}`
    }
  }))
};
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
>
  <script type="application/ld+json" set:html={JSON.stringify(blogListSchema)} />
  <BlogPost
    posts={mappedPosts}
    currentPage={currentPage}
    totalPages={totalPages}
    categories={categories}
    selectedCategory={selectedCategory}
    searchQuery={searchQuery}
  />
  <div class="pt-16"></div>
</MainLayout>
