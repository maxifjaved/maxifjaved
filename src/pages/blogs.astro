---
import { getCollection } from 'astro:content';
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const breadcrumbItems = [
  { name: "Home", url: "https://maxifjaved.com" },
  { name: "Writing", url: "https://maxifjaved.com/blogs" }
];

const posts = (
  await getCollection('blogs', ({ data }) => data.draft !== true)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<MainLayout
  title="Writing - Muhammad Asif Javed | Engineering Notes & Comparisons"
  description="Technical writing from production experience: digital signage architectures, real-time communication trade-offs, and backend engineering notes."
  keywords="digital signage architecture, WebRTC vs Socket.io, technical blog, full-stack engineering writing, Muhammad Asif Javed blog"
  canonicalUrl="https://maxifjaved.com/blogs"
>
  <Breadcrumb items={breadcrumbItems} />

  <section class="shell pb-20">
    <header class="max-w-3xl pt-10 sm:pt-14">
      <p class="eyebrow">Writing · {posts.length} pieces</p>
      <h1 class="display mt-3 text-4xl sm:text-5xl text-ink">
        Notes from <em>production.</em>
      </h1>
      <p class="mt-5 max-w-2xl font-display text-lg leading-relaxed text-ink-2">
        Long-form comparisons and engineering notes, written from systems I run
        — not from documentation.
      </p>
    </header>

    <div class="mt-10 border-b border-line">
      {posts.map((post) => (
        <article class="group border-t border-line">
          <a
            href={`/blogs/${post.slug}`}
            class="grid gap-x-6 gap-y-1 py-6 sm:grid-cols-[minmax(0,1fr)_11rem]"
          >
            <div class="min-w-0">
              <h2 class="display text-xl sm:text-2xl text-ink transition-colors group-hover:text-accent">
                {post.data.title}
              </h2>
              <p class="mt-2 max-w-xl text-[0.9375rem] leading-relaxed text-ink-2">
                {post.data.description}
              </p>
            </div>
            <div class="row-start-1 sm:row-auto flex sm:flex-col sm:items-end gap-x-4 gap-y-1 sm:text-right">
              <time
                datetime={post.data.date.toISOString()}
                class="figure-value text-sm"
              >
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </time>
              <span class="figure-label">{post.data.readTime}</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
</MainLayout>
